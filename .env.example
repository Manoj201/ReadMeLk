# Copy to .env.local and fill from Firebase console → Project settings → Your apps (Web).
# See .claude/planning/07-firebase-setup.md
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: point the app at the local Firebase Emulator Suite
VITE_USE_EMULATORS=false

# Optional: App Check (abuse / cost protection). reCAPTCHA v3 site key.
# Enable enforcement per service in the Firebase console after setting this.
VITE_APPCHECK_SITE_KEY=
# Dev only: 'true' prints a debug token to register in the console, or paste one here.
VITE_APPCHECK_DEBUG_TOKEN=
